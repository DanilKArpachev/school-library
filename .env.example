# Адрес сайта. Нет своего домена — используйте IP сервера через точки -> тире:
# например, для IP 185.22.66.10 пишите 185-22-66-10.sslip.io
DOMAIN=185-22-66-10.sslip.io

SITE_NAME=Библиотека учителя истории

# Первый администратор (создаётся при первом запуске)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=придумайте-надёжный-пароль

# Из Google Cloud Console (OAuth client, тип «Приложение для ПК»)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Случайная строка от 32 символов (install.sh создаёт её сам)
SECRET_KEY=

# Как часто проверять папку на новые файлы, минут
SYNC_INTERVAL_MIN=60

# Файлы, начинающиеся с этих слов, сразу скрываются от учителей (через запятую)
HIDE_PREFIXES=Регистрация
